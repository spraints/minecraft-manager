<h1>Who's logging in</h1>

<table>
  <thead>
    <tr>
      <th>Time</th>
      <th>Event</th>
      <th>Status</th>
      <th>Client</th>
      <th>Server</th>
      <th>Player</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |ev| %>
      <tr>
        <td><%=time_tag ev.occurred_at %></td>
        <td><%= ev.event %></td>
        <td><%= ev.status %></td>
        <td><%=client_for_event ev %></td>
        <td><%=server_for_event ev %></td>
        <td><%=player_for_event ev %></td>
      </tr>
    <% end %>
  </tbody>
</table>
