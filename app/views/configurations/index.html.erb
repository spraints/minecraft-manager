<h1>Minecraft Router Manager</h1>

This page lets you control our <a href="https://github.com/itzg/mc-router">mc-router</a> installation.

<h2>Current Configuration</h2>

<% if @current.nil? %>
  No configuration has been applied yet. Create one below to get started!
<% else %>
  <%= render "show", configuration: @current, heading: "h3" %>
<% end %>

<div><%= link_to "See who's using it", mc_router_events_path %></div>

<% if Rails.env.development? %>
  <div>dev only: <a href="/mcrouter.json">View rendered config</a></div>
<% end %>

<% unless @queued.empty? %>
  <h2>Applying Configurations</h2>

  <% @queued.each do |cfg| %>
    <%= render "show", configuration: cfg, heading: "h3" %>
    <% if cfg.updated_at < 1.minute.ago %>
      <div>
        <%= button_to "re-queue", queued_configuration_path(cfg), method: :put %>
      </div>
    <% end %>
  <% end %>
<% end %>

<h2>Pending Configurations</h2>

<ul>
  <% @proposed.each do |config| %>
    <% if @current.nil? || config.parent_id == @current.id %>
      <li>
        <%= link_to "##{config.id}", config %>
        <%= button_to "Apply", queued_configuration_path(config), method: :put %>
      </li>
    <% end %>
  <% end %>
  <li><%= link_to "New configuration", new_configuration_path %></li>
</ul>

<hr>

<%= link_to "Available worlds", minecraft_worlds_path %>
