<<%=heading%>>Configuration #<%= configuration.id %></<%=heading%>>

<% if configuration.parent_id %>
  <div>Preceeded by: <%= link_to "##{configuration.parent_id}", action: :show, id: configuration.parent_id %></div>
<% end %>
<div>State: <%= configuration.state %></div>

<div>
  <ul>
    <% configuration.active_worlds.each do |aw| %>
      <li>
        <span class="hostname"><%= aw.hostname %></span>
        &rarr;
        <span class="addr"><%= aw.world.backend_addr %></span>
      </li>
    <% end %>
  </ul>
</div>
